# Uygulama
NODE_ENV=development
PORT=4100
APP_URL=http://localhost:5173
SESSION_SECRET=change-me-32-bytes-minimum-random
ENCRYPTION_KEY=change-me-32-bytes-base64
# Veritabanı: app rolü RLS'e tabidir, owner rolü migration ve platform işleri içindir
DATABASE_URL=postgres://dentaflow_app:pass@localhost:5432/dentaflow
DATABASE_OWNER_URL=postgres://dentaflow_owner:pass@localhost:5432/dentaflow
# Dosyalar
STORAGE_DIR=./storage
# E-posta (boşsa e-postalar loglanır)
SMTP_URL=
MAIL_FROM="DentaFlow <no-reply@example.com>"
